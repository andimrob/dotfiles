[Unit]
Description=tmux piserv1 session
After=network-online.target

[Service]
Type=forking
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/tmux-piserv1
ExecStop=%h/.local/share/mise/shims/tmux kill-session -t piserv1

[Install]
WantedBy=default.target
